{
  "manifest_version": 3,
  "name": "Auto Refresh & Tab Reload",
  "version": "1.0.0",
  "key": "",
  "description": "Auto-refresh specific tabs on custom intervals, specific times, or random ranges. Quickly reload tabs, domains, selected, or left/right tabs.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "offscreen", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://frontend-cdn.perplexity.ai https://*.perplexity.ai; img-src 'self' data: https:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Refresh & Tab Reload",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "reload-all": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Reload all tabs in the current window"
    },
    "reload-selected": {
      "suggested_key": {
        "default": "Ctrl+Shift+8"
      },
      "description": "Reload and move selected tabs to the left"
    },
    "reload-domain": {
      "suggested_key": {
        "default": "Ctrl+Shift+7"
      },
      "description": "Reload same domain tabs"
    },
    "reload-others": {
      "suggested_key": {
        "default": "Ctrl+Shift+6"
      },
      "description": "Reload all other tabs"
    }
  }
}
